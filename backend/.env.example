# ── Backend Environment Variables ─────────────────────────────────────────────
# Copy this file to .env for local development.
# In Railway (production), add these as Variables in the service settings.

# Polygon API (required — free plan works for most endpoints, paid for options)
POLYGON_API_KEY=your_polygon_api_key_here

# Supabase (required — from Supabase Dashboard → Settings → API)
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# CORS — https://www.orbistrading.io and https://orbistrading.io are hardcoded
# in app.py, so no CORS env vars are needed for production.
# Set FRONTEND_URL only if you need to allow an additional origin (e.g. a preview deploy).
# FRONTEND_URL=https://preview-branch.vercel.app

# Stripe (for subscription management)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CORE_PRICE_ID=price_...
STRIPE_PREMIUM_PRICE_ID=price_...

# Anthropic (for AI analysis)
ANTHROPIC_API_KEY=sk-ant-...

# SnapTrade (for brokerage integration)
SNAPTRADE_CLIENT_ID=your_client_id
SNAPTRADE_CONSUMER_KEY=your_consumer_key

# Notifications (optional)
RESEND_API_KEY=re_...
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_FROM_NUMBER=+1...
VAPID_PRIVATE_KEY=...
VAPID_PUBLIC_KEY=...
