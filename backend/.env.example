# ── Backend Environment Variables ─────────────────────────────────────────────
# Copy this file to .env for local development.
# In Railway (production), add these as Variables in the service settings.

# Polygon API (required — free plan works for most endpoints, paid for options)
POLYGON_API_KEY=your_polygon_api_key_here

# Supabase (required — from Supabase Dashboard → Settings → API)
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# CORS — set this to your Vercel frontend URL so the browser can call the API
# The FRONTEND_URL value is always added automatically, so just setting that is enough.
FRONTEND_URL=https://your-app.vercel.app
# Optional: add more comma-separated origins
# CORS_ORIGINS=https://your-app.vercel.app,https://custom-domain.com

# Stripe (for subscription management)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CORE_PRICE_ID=price_...
STRIPE_PREMIUM_PRICE_ID=price_...

# Anthropic (for AI analysis)
ANTHROPIC_API_KEY=sk-ant-...

# SnapTrade (for brokerage integration)
SNAPTRADE_CLIENT_ID=your_client_id
SNAPTRADE_CONSUMER_KEY=your_consumer_key

# Notifications (optional)
RESEND_API_KEY=re_...
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_FROM_NUMBER=+1...
VAPID_PRIVATE_KEY=...
VAPID_PUBLIC_KEY=...
