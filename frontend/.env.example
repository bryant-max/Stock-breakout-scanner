# ── Frontend Environment Variables ────────────────────────────────────────────
# Copy this file to .env.local for local development.
# In Vercel (production), add these as Environment Variables in the dashboard.

# Your Railway backend URL (no trailing slash).
# Find it in Railway → your backend service → Settings → Domains.
# Example: https://stock-breakout-scanner-production.up.railway.app
VITE_API_URL=https://YOUR_RAILWAY_SERVICE.up.railway.app

# Supabase project settings (from Supabase Dashboard → Settings → API)
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
